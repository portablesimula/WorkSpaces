<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.portablesimula.SimulaPlugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>SimulaPlugin</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://portablesimula.github.io/github.io/">Portable Simula</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <!--description><![CDATA[
        Enter short description for your plugin here.<br>
        <em>most HTML tags may be used</em>
    ]]></description-->
    <description><![CDATA[
    Provides simple development tools for the <a href="https://portablesimula.github.io/github.io/">Simula</a> language.
  ]]></description>
    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Following line: Cannot resolve plugin 'com.intellij.modules.java' in dependencies  -->
    <depends>com.intellij.modules.java</depends>

    <applicationListeners>
        <listener class="simula.plugin.extensions.start_close.SimulaProjectCloseListener"
            topic="com.intellij.openapi.project.ProjectCloseListener"/>
        <listener class="simula.plugin.actions.MyActionLogger"
                  topic="com.intellij.openapi.actionSystem.ex.AnActionListener"/>
        <!--listener class="simula.plugin.util.MyVfsListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/-->
    </applicationListeners>

    <projectListeners>
        <!--listener class="simula.plugin.util.MyVfsListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/-->
    </projectListeners>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">

        <!--postStartupActivity implementation="simula.plugin.extensions.start_close.SimulaStartupActivity"/-->
        <postStartupActivity implementation="simula.plugin.MyProjectActivityWrapper"/>

        <fileType name="Simula" implementationClass="simula.lang.SimulaFileType"
                fieldName="INSTANCE" language="Simula" extensions="sim"/>

        <!-- Registering the custom file drop handler -->
        <fileDropHandler implementation="simula.plugin.util.MyFileDropHandler" order="first"/>

        <lang.syntaxHighlighterFactory
                language="Simula"
                implementationClass="simula.plugin.extensions.highlighter.syntaxHighlighter.SimulaSyntaxHighlighterFactory"/>

        <!-- New Project -->
        <newProjectWizard.languageGenerator implementation="simula.plugin.extensions.newProject.SimulaNewProjectWizard"/>
        <!--treeStructureProvider implementation="simula.plugin.extensions.newProject.MyTreeStructureProvider"/-->

        <!-- Console tool Window -->
        <!--toolWindow id="Simula Compiler Console" anchor="bottom"
                factoryClass="simula.plugin.extensions.toolWindows.ConsoleToolWindowFactory"
                icon="/images/favico.png" /-->

        <toolWindow id="Simula Console" anchor="bottom"
                    factoryClass="simula.plugin.extensions.toolWindows.ConsoleToolWindowFactory"
                    icon="/images/favico.png" />

        <!--toolWindow id="MyCustomProjectView"
                    anchor="left"
                    factoryClass="simula.plugin.extensions.toolWindows.MyCustomToolWindowFactory"
                    icon="/images/favico.png" /-->

        <projectViewNodeDecorator implementation="simula.plugin.extensions.newProject.SimulaNodeDecorator"/>

        <!-- Run Configuration -->
            <!-- Register your main configuration type first -->
            <!--configurationType implementation="simula.plugin.extensions.config.SimulaRunConfigurationType"/-->
            <configurationType implementation="simula.plugin.extensions.config.SimulaRunConfigurationType"/>

            <!-- Register the producer to link it to the context menu -->
            <runConfigurationProducer implementation="simula.plugin.extensions.config.SimulaFileRunConfigurationProducer"/>

        <programRunner implementation="simula.plugin.extensions.exec.SimulaProgramRunner"/>

        <!--executor implementation="simula.plugin.extensions.config.run.cmdRunner.UNUSED_InCmdExecutor"/-->
        <!--projectConfigurable instance="simula.plugin.extensions.config.run.cmdRunner.UNUSED_InCmdConfigurable"/-->
        <!--projectService serviceImplementation="simula.plugin.extensions.config.run.cmdRunner.UNUSED_OptionsPatchConfiguration"/-->

        <!--typedHandler implementation="simula.plugin.extensions.config.run.cmdRunner.UNUSED_SimulaKeyHandler"/-->

        <!-- ***************************************** -->
        <!-- ****** EXTENSIONS FOR PARSING ETC: ****** -->
        <!-- ***************************************** -->

        <lang.parserDefinition
                language="Simula"
                implementationClass="simula.parser.SimulaParserDefinition"/>

        <lang.ast.factory language="Simula"
             implementationClass="simula.parser.SimulaASTFactory"/>

    </extensions>

    <actions>

        <action id="MyPlugin.MyAction"
                class="simula.plugin.actions.toolsMenu.SimulaOptions"
                text="My Plugin Menu Item"
                description="A description for my plugin's menu item">
            <add-to-group group-id="HelpMenu" anchor="first"/>
            <!-- Or other group-id like "FileMenu", "EditMenu", "ProjectViewPopupMenu", etc. -->
            <!-- Anchor can be "first", "last", "before", or "after" with a specific action ID -->
        </action>

        <action id="com.example.CreateMyFile"
                class="simula.plugin.actions.CreateNewFileAction"
                text="Simula"
                description="Creates a new Simula file">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>
        </action>

    </actions>
</idea-plugin>