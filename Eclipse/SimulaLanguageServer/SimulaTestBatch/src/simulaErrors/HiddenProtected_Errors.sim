begin
	-- Expecting: Error: y is specified Hidden without being Protected
	class C(x); ref(C) x; hidden y; begin
		integer y;
	end;
	
	-- Expecting: No error
	class D(x); ref(D) x; hidden protected y; virtual: procedure zz;
	begin
		integer y;
		procedure zz;;
	end;
	
	-- Expecting: Error: No Attribute zy match 'protected' specification
	class E(x); ref(D) x; hidden protected zy;
	begin
		integer ya;
	end;
	
	-- Expecting: Error: A virtual attribute may only be specified protected in the class heading in which the virtual specification occurs.
	D class F(z); ref(C) z; protected zz; begin
		integer zy;
	end;
end;