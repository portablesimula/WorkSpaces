begin
     switch(lowKey:hiKey) key
      begin

         when none do begin
              goto NOMORE;
         end;
         
         when case1 do begin
             goto BREAK;
         end;

         when case2 do begin
              trace(msg & " selected case 2");
              goto BREAK;
         end;

         when 3 do begin
              goto BREAK;
         end;

         when none do begin
              trace(msg & " selected case NONE");
              goto NOMORE;
         end;
      end case;

end