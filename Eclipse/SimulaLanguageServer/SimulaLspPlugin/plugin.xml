      </contentAssistProcessor>
   </extension>
   -->

   <!-- 5. Provide Documentation / Tooltips (Hover Providers) -->
   <!-- SEE: serverCapabilities.setHoverProvider(true) -->
   <!--                                                                           Defines: Hover Providers -->
   <!--
   <extension point="org.eclipse.ui.genericeditor.hoverProviders">
      <hoverProvider
            class="com.simula.client.editor.NOT_USED_SimulaTextHoverProvider"
            contentType="com.simula.contenttype">
      </hoverProvider>
   </extension>
   -->


   
   <!--                                                                           Debug Adapter -->
	<extension point="org.eclipse.lsp4e.debug.debugAdapterFactories">
	    <debugAdapterFactory
	        id="com.simula.dap.debugAdapterFactory"
	        class="com.simula.dap.SimulaDebugAdapterFactory"
	        language="simula">
	    </debugAdapterFactory>
	</extension>
   <!--
	<extension point="org.eclipse.lsp4e.debug.adapterType">
	    <adapterType
	        id="com.simula.dap.adapterType"
	        name="My Custom Debugger"
	        launchCommandProvider="com.simula.dap.MyDebugAdapterCommandProvider">
	    </adapterType>
	</extension>
   <extension
         point="org.eclipse.lsp4e.debug.adapterType">
      <adapterType
            id="com.simula.dap.simulaAdapterType"
            name="Simula Resource JAR Debugger"
            class="com.simula.dap.ResourceJarDebugAdapterProvider">
      </adapterType>
   </extension>
	-->

	<extension point="org.eclipse.lsp4e.debug.adapterType">
	    <adapterType
	        id="com.simula.dap.adapter"
	        name="Simula Debug Adapter"
	        label="Simula Debugger">
	        
	        <!-- Siden DAP-serveren forventer TCP-tilkobling på port 4711 -->
	        <serverLaunch
	            mode="connect"
	            host="127.0.0.1"
	            port="4711">
	        </serverLaunch>
	    </adapterType>
	</extension>

   <!--                                                                           Property Testers -->
   <extension point="org.eclipse.core.expressions.propertyTesters">
      <propertyTester
            id="com.simula.simulaProjectTester"
            type="org.eclipse.core.resources.IResource"
            namespace="com.simula"
            properties="isSimulaProject"
            class="com.simula.client.run.SimulaProjectTester">
      </propertyTester>
   </extension>

   <!--                                                                           Run / Debug -->
	<extension point="org.eclipse.debug.core.launchConfigurationTypes">
		<!-- LATER: MAYBE ADD:
		     sourceLocatorId="org.eclipse.jdt.launching.sourceLocator.JavaSourceLookupDirector" -->
	    <launchConfigurationType
	        id="com.simula.launchType"
	        name="Simula Application#1"
			icon="icons/favico.png"
	        delegate="com.simula.client.run.SimulaLaunchDelegate"
	        modes="run, debug">
	    </launchConfigurationType>
	</extension>

	<extension point="org.eclipse.debug.ui.launchConfigurationTypeImages">
	   <launchConfigurationTypeImage
	         configTypeID="com.simula.launchType"
			 icon="icons/favico.png"
	         id="com.simula.launchTypeImage">
	   </launchConfigurationTypeImage>
	</extension>

   <extension
         point="org.eclipse.debug.ui.launchConfigurationTabGroups">
      <launchConfigurationTabGroup
            id="com.simula.client.run.SimulaRunTabGroup"
            type="com.simula.launchType"
            class="com.simula.client.run.SimulaRunTabGroup">
      </launchConfigurationTabGroup>
   </extension>
	   
   <extension point="org.eclipse.debug.ui.launchShortcuts">
	   <shortcut
		      id="com.simula.ide.launchShortcut"
		      class="com.simula.client.run.SimulaLaunchShortcut"
		      label="Simula Application#2"
			  icon="icons/favico.png"
		      modes="run, debug">
	      
	      <contextualLaunch>
	         <contextLabel mode="run" label="Run Simula Application" />
	         <contextLabel mode="debug" label="Debug Simula Application" />
	         
	         <enablement>
	            <with variable="selection">
	               <!-- Sørg for at nøyaktig én fil er valgt/aktiv -->
	               <count value="1"/>
	               <iterate>
	                  <!-- Tilpass objektet til en IResource for å sjekke filnavn -->
	                  <adapt type="org.eclipse.core.resources.IResource">
	                     <and>
	                        <!-- Trigger snarveien kun hvis filen slutter på .sim -->
	                        <test 
	                           property="org.eclipse.core.resources.name" 
	                           value="*.sim"/>
	                     </and>
	                  </adapt>
	               </iterate>
	            </with>
	         </enablement>
	      </contextualLaunch>
	      
	   </shortcut>
	</extension>


   

   <!--                                                                           Export Wizards -->
   <extension
         point="org.eclipse.ui.exportWizards">
      <category
            id="com.simula.export.category"
            name="Simula">
      </category>
      <wizard
            id="com.simula.ExportWizard"
            name="Runnable Simula JAR File"
            class="com.simula.client.export.SimulaExportWizard"
			category="com.simula.export.category"
            icon="icons/favico.png">
         <description>
            Export a Simula project into a runnable JAR file.
         </description>
         <selection class="org.eclipse.core.resources.IResource"/>
      </wizard>
   </extension>


</plugin>
