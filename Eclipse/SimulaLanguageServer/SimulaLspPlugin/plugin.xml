<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!--                                                                           Startup -->
	<extension point="org.eclipse.ui.startup">
	    <startup class="com.simula.client.SimulaStartupHandler"/>
	</extension>
   
   <!--                                                                           Preferences -->
	<extension point="org.eclipse.core.runtime.preferences">
	   <initializer class="com.simula.client.preferences.SimulaPreferenceInitializer"/>
	</extension>
   
   <extension point="org.eclipse.ui.preferencePages">
	   <!-- Main Root Category for Simula -->
	   <page
	         id="com.simula.client.preferences.SimulaMainPreferencePage"
	         name="Simula"
	         class="com.simula.client.preferences.SimulaPreferencePage">
	   </page>
	   <page
	         id="com.simula.client.preferences.SimulaLspPage"
	         name="Lsp Info"
	         category="com.simula.client.preferences.SimulaMainPreferencePage"
	         class="com.simula.client.preferences.SimulaLspPreferencePage">
	   </page>
	   
	   <!-- Optional: Child preference page (e.g., Code Formatting or Syntax Coloring) -->
	   <!--
	   <page
	         id="com.example.simula.preferences.SimulaSyntaxColorPage"
	         name="Syntax Coloring"
	         category="com.example.simula.preferences.SimulaMainPreferencePage"
	         class="com.example.simula.preferences.SimulaColorPreferencePage">
	   </page>
	   -->
	</extension>
   
   <!--                                                                           Content types -->
   <extension
         point="org.eclipse.core.contenttype.contentTypes">
      <content-type
            id="com.simula.contenttype"
            name="Simula Source File"
            base-type="org.eclipse.core.runtime.text"
            file-extensions="sim"
            priority="normal">
      </content-type>
   </extension>
   
   <!--                                                                           Menu: About -->

   <!-- 1. Define the Command -->
   <extension point="org.eclipse.ui.commands">
      <command
            id="com.simula.plugin.commands.aboutSimula"
            name="About Simula">
      </command>
   </extension>

   <!-- 2. Bind the Command to your Help Menu Implementation -->
   <extension point="org.eclipse.ui.handlers">
      <handler
            class="com.simula.client.handlers.AboutSimulaHandler"
            commandId="com.simula.plugin.commands.aboutSimula">
      </handler>
   </extension>

   <!-- 3. Contribute the item to the Help Menu -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="menu:help?after=additions">
         <command
               commandId="com.simula.plugin.commands.aboutSimula"
               label="About Simula"
               id="com.simula.plugin.menu.aboutSimula"
               icon="icons/favico.png"
               style="push">
         </command>
      </menuContribution>
   </extension>
   
   <!--                                                                           Project Nature -->
	<extension 
	    id="simulaNature" 
	    name="Simula Project Nature" 
	    point="org.eclipse.core.resources.natures">
	    <runtime>
	      <run class="com.simula.client.SimulaNature"/>
	    </runtime>
		<builder id="no.simula.ide.simulaBuilder"/>
   </extension>

	<extension point="org.eclipse.ui.ide.projectNatureImages">
	   <image
	         id="com.simula.ide.ui.simulaProjectImage"
	         natureId="com.simula.ide.core.simulaNature"
	         icon="icons/favico.png">
	   </image>
	</extension>
   

   <extension
         id="com.simula.server"
         name="Simula Language Server"
         point="org.eclipse.lsp4e.languageServer">
      <server
            id="com.simula.server"
            label="Simula Language Server"
            class="com.simula.client.SimulaStreamConnectionProvider">
      </server>
      
      <contentTypeMapping
            contentType="com.simula.contenttype"
            id="com.simula.server"
            languageId="Simula">
      </contentTypeMapping>
   </extension>

   
   <!--                                                                           Bind Content type to the Generic Editor -->
	<extension point="org.eclipse.ui.editors">
	   <editorContentTypeBinding
	         contentTypeId="com.simula.contenttype"
	         editorId="org.eclipse.ui.genericeditor.GenericEditor">
	   </editorContentTypeBinding>
	</extension>

   <!--                                                                           Bind Simula Icon to the Generic Editor -->
	<extension point="org.eclipse.ui.genericeditor.icons">
	    <icon 
	        contentType="com.simula.contenttype" 
	        icon="icons/favico.png">
	    </icon>
	</extension>

   <!--                                                                           Label Decorators -->
	<extension point="org.eclipse.ui.decorators">
	   <decorator
	         id="com.example.simula.fileDecorator"
	         label="Simula File Decorator"
	         state="true"
	         class="com.simula.client.ui.SimulaLabelDecorator"
	         objectClass="org.eclipse.core.resources.IFile"
	         adaptable="true">
	      <description>
	         Adds custom icons to Simula language source files.
	      </description>
	   </decorator>
	</extension>



   <!-- 3. Provide Syntax Highlighting (Presentation Reconciler) -->
   <!-- EXAMPLE
   <extension
         point="org.eclipse.ui.genericeditor.presentationReconcilers">
      <presentationReconciler
            class="org.eclipse.tm4e.ui.text.TMPresentationReconciler"   // DETTE ER EN DEFAULT
            contentType="org.eclipse.acute.csharp">
      </presentationReconciler>
   </extension>
   -->
   <!--                                                                           Provide Syntax Highlighting -->
   <extension point="org.eclipse.ui.genericeditor.presentationReconcilers">
      <presentationReconciler
            class="com.simula.client.editor.MyLanguagePresentationReconciler"
            contentType="com.simula.contenttype">
      </presentationReconciler>
   </extension>
   
   
   
   
   <!-- =====================================================================
   Dette punktet lar utviklere koble en VS Code-kompatibel language-configuration.json-fil
   til en spesifikk filtype (Content Type) i Eclipse. Mens TextMate-grammatikken håndterer
   selve fargeleggingen (syntax highlighting), brukes denne konfigurasjonen til å styre
   redigeringsfunksjonalitet som:
   • Auto-lukking av klammer og sitattegn (auto close)
   • Kommentering (ut- og innkommentering av linjer/blokker)
   • Parre klammer (matching brackets)
   • Smarte innrykk når du trykker Enter (on enter support)   
   
   NOTE: SER IKKE UT TIL Å VIRKE   -->
   
   <!-- EXAMPLE:
   <extension
         point="org.eclipse.tm4e.languageconfiguration.languageConfigurations">
      <languageConfiguration
            contentTypeId="org.eclipse.acute.csharp"
            path="language-configurations/language-configuration.json">
      </languageConfiguration>
   </extension>
   -->
   <!--                                                                           Defines: Auto close etc. -->
   <extension
         point="org.eclipse.tm4e.languageconfiguration.languageConfigurations">
      <languageConfiguration
            contentTypeId="com.simula.contenttype"
            path="language-configurations/language-configuration.json">
      </languageConfiguration>
   </extension>

   <!--                                                                           Defines: Simula Perspective -->
   <!-- 1. Definer selve perspektivet -->
   <extension point="org.eclipse.ui.perspectives">
      <perspective
            id="com.simula.client.ui.SimulaPerspective"
            name="Simula"
	        class="com.simula.client.ui.SimulaPerspectiveFactory"
	        icon="icons/favico.png">
      </perspective>
   </extension>

   <!-- 2. Gjør perspektivet tilgjengelig i "New Wizard" snarveier -->
   <!--                                                                           Perspective Extensions -->
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="com.simula.client.ui.SimulaPerspective">
        <view
            id="org.eclipse.ui.internal.introview"
            relationship="right"
            relative="org.eclipse.ui.editorss"
            visible="false"/>
         <!-- Erstatter "YOUR_SIMULA_WIZARD_ID" med ID-en til din File->New Wizard -->
         <newWizardShortcut id="com.simula.client.newWizard.NewSimulaProjectWizard"/>
         <newWizardShortcut id="com.simula.client.newWizard.NewSimulaFileWizard"/>
      </perspectiveExtension>
   </extension>

	<!--
    For at veiviseren skal dukke opp som en direkte snarvei i File > New-menyen
	når en bruker befinner seg i et spesifikt perspektiv (f.eks. Java-perspektivet
	eller Ressurs-perspektivet), legger du til følgende kode:	-->
	<extension point="org.eclipse.ui.perspectiveExtensions">
	   <perspectiveExtension targetID="org.eclipse.ui.resourcePerspective">
	      <newWizardShortcut id="no.mittfirma.minveiviser.id"/>
	   </perspectiveExtension>
	   <!-- Du kan også legge den til i Java-perspektivet -->
	   <perspectiveExtension targetID="org.eclipse.jdt.ui.JavaPerspective">
	      <newWizardShortcut id="no.mittfirma.minveiviser.id"/>
	   </perspectiveExtension>
	</extension>
   
	<!--                                                                          File -> New   Wizards	-->   
	<extension point="org.eclipse.ui.newWizards">
	   <!-- Optional: Create a custom category/folder for your wizard -->
	   <category 
	         id="com.simula.client.category" 
	         name="Simula">
	   </category>
	   
	   <!-- New Simula File Wizard -->
	   <!--
	   <wizard
	         id="com.simula.client.wizard.mywizard"
	         name="New Simula File"
	         category="com.simula.client.category"
	         class="com.simula.client.newWizard.NewSimulaFileWizard"
	         icon="icons/favico.png">
	      <description>Creates a custom artifact file inside your project.</description>
	      <selection class="org.eclipse.core.resources.IResource"/>
	   </wizard>
	   -->
	   <!-- New Simula Project Wizard -->
	   <wizard
	         id="com.simula.client.wizards.NewSimulaProjectWizard"
	         name="New Simula Project"
	         category="com.simula.client.category"
	         class="com.simula.client.newWizard.NewSimulaProjectWizard"
	         icon="icons/favico.png"
	         project="true">
	      <description>
	         Create a pre-configured Custom Project.
	      </description>
	   </wizard>
	</extension>
   
   <!--                                                                           Defines: createProject Command -->
   <extension point="org.eclipse.ui.commands">
    <command
        id="com.simula.ide.commands.createProject"
        name="Create Simula Project">
    </command>
	</extension>

   <!--                                                                           Defines: Handlers -->
	<extension point="org.eclipse.ui.handlers">
	    <handler
	        class="com.simula.client.newWizard.CreateSimulaProjectHandler"
	        commandId="com.simula.ide.commands.createProject">
	    </handler>
	</extension>
   

   <!--                                                                           Navigator Viewer -->
	<extension point="org.eclipse.ui.navigator.viewer">
	   <viewerContentBinding viewerId="org.eclipse.ui.navigator.ProjectExplorer">
	      <includes>
	         <contentExtension pattern="com.example.myplugin.navigatorContent"/>
	      </includes>
	   </viewerContentBinding>
	</extension>

	<extension point="org.eclipse.ui.navigator.navigatorContent">
	   <navigatorContent
	         id="com.example.myplugin.navigatorContent"
	         name="Custom Mapper Content"
	         contentProvider="com.example.myplugin.navigator.MapperContentProvider"
	         labelProvider="com.example.myplugin.navigator.MapperLabelProvider"
	         activeByDefault="true">
	         
	      <!-- This ensures your provider triggers when a file ends with .mapper -->
	      <triggerPoints>
	         <or>
	            <and>
	               <instanceof value="org.eclipse.core.resources.IFile"/>
	               <test property="org.eclipse.core.resources.extension" value="mapper"/>
	            </and>
	         </or>
	      </triggerPoints>
	      
	      <!-- Declares what kind of objects this provider outputs -->
	      <possibleChildren>
	         <or>
	            <instanceof value="com.example.myplugin.model.MapperElement"/>
	         </or>
	      </possibleChildren>
	   </navigatorContent>
	</extension>
	


   <!-- 4. Provide Code Completion (Content Assist Processors) -->
   <!-- SEE: serverCapabilities.setCompletionProvider -->
   <!--                                                                           Defines: Content Assists Processors -->
   <!--
   <extension point="org.eclipse.ui.genericeditor.contentAssistProcessors">
      <contentAssistProcessor
            class="com.simula.client.editor.SimulaContentAssistProcessor"
            contentType="com.simula.contenttype">
      </contentAssistProcessor>
   </extension>
   -->

   <!-- 5. Provide Documentation / Tooltips (Hover Providers) -->
   <!-- SEE: serverCapabilities.setHoverProvider(true) -->
   <!--                                                                           Defines: Hover Providers -->
   <!--
   <extension point="org.eclipse.ui.genericeditor.hoverProviders">
      <hoverProvider
            class="com.simula.client.editor.SimulaTextHoverProvider"
            contentType="com.simula.contenttype">
      </hoverProvider>
   </extension>
   -->


   
   <!--                                                                           Debug Adapter -->
   <!--
	<extension point="org.eclipse.lsp4e.debug.adapterType">
	    <adapterType
	        id="com.simula.dap.adapterType"
	        name="My Custom Debugger"
	        launchCommandProvider="com.simula.dap.MyDebugAdapterCommandProvider">
	    </adapterType>
	</extension>
   <extension
         point="org.eclipse.lsp4e.debug.adapterType">
      <adapterType
            id="com.simula.dap.simulaAdapterType"
            name="Simula Resource JAR Debugger"
            class="com.simula.dap.ResourceJarDebugAdapterProvider">
      </adapterType>
   </extension>
	-->

	<extension point="org.eclipse.lsp4e.debug.adapterType">
	    <adapterType
	        id="simula.debug.adapter"
	        name="Simula Debug Adapter"
	        label="Simula Debugger">
	        
	        <!-- Siden DAP-serveren forventer TCP-tilkobling på port 4711 -->
	        <serverLaunch
	            mode="connect"
	            host="127.0.0.1"
	            port="4711">
	        </serverLaunch>
	    </adapterType>
	</extension>

   <!--
   <extension point="org.eclipse.debug.core.launchConfigurationTypes">
	   <launchConfigurationType
	         id="com.simula.debug.launchType"
	         name="Simula Application"
	         delegate="org.eclipse.lsp4e.debug.launcher.DSPLaunchDelegate"
	         modes="run, debug">
	   </launchConfigurationType>
	</extension>
	-->
	<extension point="org.eclipse.debug.core.launchConfigurationTypes">
	    <launchConfigurationType
	         id="com.simula.launchType"
	         name="Simula Application#1"
			 icon="icons/favico.png"
	        delegate="com.simula.dap.SimulaLaunchDelegate"
	        modes="run, debug"
	        sourceLocatorId="org.eclipse.jdt.launching.sourceLocator.JavaSourceLookupDirector">
	    </launchConfigurationType>
	</extension>

	<extension
	      point="org.eclipse.debug.ui.launchConfigurationTypeImages">
	   <launchConfigurationTypeImage
	         configTypeID="com.simula.launchType"
			 icon="icons/favico.png"
	         id="com.simula.launchTypeImage">
	   </launchConfigurationTypeImage>
	</extension>

   <extension
         point="org.eclipse.debug.ui.launchConfigurationTabGroups">
      <launchConfigurationTabGroup
            class="com.simula.client.run.SimulaRunTabGroup"
            id="com.simula.client.run.SimulaRunTabGroup"
            type="com.simula.launchType">
      </launchConfigurationTabGroup>
   </extension>

   <extension point="org.eclipse.core.expressions.propertyTesters">
      <propertyTester
            id="com.simula.simulaProjectTester"
            type="org.eclipse.core.resources.IResource"
            namespace="com.simula"
            properties="isSimulaProject"
            class="com.simula.SimulaProjectTester">
      </propertyTester>
   </extension>
	   
	<extension point="org.eclipse.debug.ui.launchShortcuts">
	   <shortcut
	         id="com.simula.ide.launchShortcut"
	         class="com.simula.dap.SimulaLaunchShortcut"
	         label="Simula Application#2"
			 icon="icons/favico.png">
	         modes="run, debug">
	         <!--
	      <contextualLaunch>
	         <enablement>
	            <with variable="selection">
	               <count value="1"/>
	               <iterate>
	                  <test property="org.eclipse.core.resources.name" value="sim"/>
	               </iterate>
	            </with>
	         </enablement>
	      </contextualLaunch>
	      -->
          <configurationType
             id="com.simula.launchType"
			 icon="icons/favico.png">
          </configurationType>
	   </shortcut>
	</extension>
   
   <extension point="org.eclipse.ui.menus">
	   <menuContribution
	         locationURI="popup:org.eclipse.ui.popup.any?after=additions">
	      <menu
	            id="org.eclipse.debug.ui.contextualLaunch.run.submenu"
	            label="Run As">
	         <command
	               commandId="org.eclipse.debug.ui.commands.LaunchLast"
	               label="Simula Application#4"
				   icon="icons/favico.png"
	               style="push">
	            <visibleWhen checkEnabled="false">
	               <with variable="selection">
	                  <count value="1"/>
	                  <iterate>
	                     <test property="org.eclipse.core.resources.extension" value="sim"/>
	                  </iterate>
	               </with>
	            </visibleWhen>
	         </command>
	      </menu>
	   </menuContribution>
	</extension>
   

   <!--                                                                           Builders -->
   <extension
         id="com.simula.builder"
         name="Simula Inclemental Builder"
         point="org.eclipse.core.resources.builders">
      <builder
            hasNature="true"> <!-- Sett til true hvis den krever en spesifikk Project Nature -->
         <run
               class="com.simula.builders.SimulaBuilder">
         </run>
      </builder>
   </extension>
   

   <!--                                                                           Export Wizards -->
   <extension
         point="org.eclipse.ui.exportWizards">
      <category
            id="com.simula.export.category"
            name="Simula">
      </category>
      <wizard
            id="com.simula.ExportWizard"
            name="Runnable Simula JAR File"
            class="com.simula.client.export.SimulaExportWizard"
			category="com.simula.export.category"
            icon="icons/favico.png">
         <description>
            Export a Simula project into a runnable JAR file.
         </description>
         <selection class="org.eclipse.core.resources.IResource"/>
      </wizard>
   </extension>


</plugin>
